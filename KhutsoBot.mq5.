
#property strict
#property version "1.00"
#property description "Khutso Forex Bot - EMA Crossover"

#include <Trade/Trade.mqh>
CTrade trade;

input int FastEMA = 9;
input int SlowEMA = 21;
input double LotSize = 0.01;
input int StopLossPoints = 300;
input int TakeProfitPoints = 600;
input ulong MagicNumber = 20261011;

int fastHandle;
int slowHandle;

int OnInit()
{
   if(FastEMA <= 0 || SlowEMA <= FastEMA ||
      LotSize <= 0)
      return INIT_PARAMETERS_INCORRECT;

   fastHandle = iMA(_Symbol, PERIOD_CURRENT, FastEMA,
                    0, MODE_EMA, PRICE_CLOSE);
   slowHandle = iMA(_Symbol, PERIOD_CURRENT, SlowEMA,
                    0, MODE_EMA, PRICE_CLOSE);

   if(fastHandle == INVALID_HANDLE ||
      slowHandle == INVALID_HANDLE)
      return INIT_FAILED;

   trade.SetExpertMagicNumber(MagicNumber);
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   IndicatorRelease(fastHandle);
   IndicatorRelease(slowHandle);
}

void OnTick()
{
   double fast[3], slow[3];

   if(CopyBuffer(fastHandle, 0, 0, 3, fast) != 3 ||
      CopyBuffer(slowHandle, 0, 0, 3, slow) != 3)
      return;

   // Use the last two completed candles
   bool buySignal =
      fast[2] <= slow[2] && fast[1] > slow[1];

   bool sellSignal =
      fast[2] >= slow[2] && fast[1] < slow[1];

   if(!buySignal && !sellSignal)
      return;

   if(PositionSelect(_Symbol))
      return;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   if(buySignal)
      trade.Buy(LotSize, _Symbol, 0,
         NormalizeDouble(ask - StopLossPoints * point, digits),
         NormalizeDouble(ask + TakeProfitPoints * point, digits),
         "Khutso EMA Buy");

   if(sellSignal)
      trade.Sell(LotSize, _Symbol, 0,
         NormalizeDouble(bid + StopLossPoints * point, digits),
         NormalizeDouble(bid - TakeProfitPoints * point, digits),
         "Khutso EMA Sell");
}

